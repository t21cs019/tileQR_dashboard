# Python
__pycache__/
*.py[oc]
.venv/
*.egg-info/

# 取り込みデータ・生成物（マシンごとに異なるため除外）
inbox/onedrive/**
inbox/manual/**
store/*.parquet
output/*.png
output/*.pdf

# 計測プラン（ソースごとにアップロード・編集。データ扱いで除外）
plan/**
!plan/.gitkeep

# inbox/ のサブフォルダ自体は残す（.gitkeep）
!inbox/onedrive/.gitkeep
!inbox/manual/.gitkeep

# 受信APIの共有トークン等（.env.example のみコミット）
.env
